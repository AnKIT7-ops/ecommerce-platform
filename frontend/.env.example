# Base URL of the FastAPI backend.
# Left empty so requests go to this same origin and Vite proxies them to the
# backend (see `server.proxy` in vite.config.ts). That keeps the dev server off
# the backend CORS allowlist, so it can run on any port. Set an absolute URL
# here only to bypass the proxy - then that origin must be in CORS_ORIGINS.
VITE_API_URL=
