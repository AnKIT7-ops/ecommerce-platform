# ---------------------------------------------------------------------------
# Backend environment configuration
# Copy to .env and fill in real values.  NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string for the application database.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/ecommerce_db

# Separate database used by the test suite. It is created automatically by the
# test fixtures if it does not exist, and is wiped between runs.
TEST_DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/ecommerce_test_db

# --- Security ---------------------------------------------------------------
# Secret used to sign JWTs. REQUIRED - the app refuses to start without it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe

# JWT algorithm and token lifetimes.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS -------------------------------------------------------------------
# Comma-separated list of origins allowed to call this API.
# The Vite dev server runs on 5173 by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Application ------------------------------------------------------------
# "development" enables verbose errors locally; use "production" otherwise.
ENVIRONMENT=development

# --- Seed data --------------------------------------------------------------
# Credentials for the initial admin account created by `python -m app.seed`.
# The seed script REFUSES to run if these are unset - there is no default admin.
# Use a real password you control; this file is only a template.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_choose_a_strong_password
